# Optional. Omitted uses the built-in isolated-test backend:
# https://wnmsnezogvtm.cloud.zyyc.chat
# JIABAN_BASE_URL=https://alternate-test-api.example.com
# Option A: deployment Secret injects a short-lived session
# JIABAN_SESSION_TOKEN=replace-with-internal-test-session
# Option B: deployment Secret injects a dedicated test account instead
JIABAN_INTEGRATION_PHONE=13800000000
JIABAN_INTEGRATION_PASSWORD=replace-with-dedicated-test-password
# Optional login role; omitted defaults to SENIOR_ADMIN
# JIABAN_ACTIVE_ROLE=TRUST_SPECIALIST
# Optional test isolation only; must be absolute
JIABAN_CONFIG_DIR=C:\\internal-test\\jiaban-cli

# Generic API is off unless explicitly enabled in an isolated test host
JIABAN_CLI_FULL_ACCESS_ENABLED=false
# Required only for DELETE and high-risk paths; never enable in production
JIABAN_CLI_DESTRUCTIVE_ENABLED=false
# Required only when a request reads or writes files; must be absolute
JIABAN_CLI_UPLOAD_ROOT=C:\\internal-test\\jiaban-upload
JIABAN_CLI_DOWNLOAD_ROOT=C:\\internal-test\\jiaban-download
